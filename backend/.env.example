PROJECT_NAME="CAI Campus Intelligence API"
PROJECT_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:5173"]

# Supabase Credentials (backend operations use service role key)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-placeholder"
SUPABASE_KEY="your-supabase-service-role-key-placeholder"
SUPABASE_ANON_KEY="your-supabase-anon-key-placeholder"

# Gemini API
GEMINI_API_KEY="your-gemini-api-key-placeholder"

# Ingestion / processing limits
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_PAGE_COUNT=10
